{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixelnest",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  // Must be <= newest date supported by local workerd (currently 2026-10-30)
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}